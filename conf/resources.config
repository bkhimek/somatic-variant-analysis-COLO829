// Configurable QC thresholds and resource paths, kept separate from nextflow.config
// so they can be tuned after Phase 2 (contamination estimation) without touching
// profile/executor definitions. Values below are the plan's starting defaults —
// the plan explicitly says not to treat these as final until the real COLO829
// contamination.table has been inspected (Module 3 design note).

params {
    qc {
        contamination {
            warn_threshold = 0.02   // >2% triggers WARN
            fail_threshold = 0.05   // >5% triggers FAIL
        }
    }
}

// TODO (Phase 2): revisit these thresholds once Module 3 has actually been run
// against the real COLO829/COLO829BL contamination table, and document the
// rationale for the final values in docs/data_sources.md per the plan's
// Module 3 design note.
