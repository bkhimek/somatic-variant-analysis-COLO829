# Raw sequencing / alignment data — never commit
*.fastq
*.fastq.gz
*.fq.gz
*.bam
*.bai
*.cram
*.crai
*.fna
*.fasta
*.fa
*.fa.fai

# Licensed / restricted reference data — never commit
COSMIC_*.tsv
cosmic_*.tsv

# Downloaded reference/truth-set data — large, publicly re-downloadable, not pipeline output.
# See docs/data_sources.md for exact download/extraction commands to regenerate this folder.
# (Scoped to this one directory, not a blanket *.vcf rule, so small hand-built test
# fixture VCFs elsewhere in the repo — e.g. tests/fixtures/ — aren't silently excluded.)
/truth_set/

# Nextflow / pipeline run artifacts
work/
results/
.nextflow/
.nextflow.log*

# VEP cache (large, downloaded not committed)
vep_cache/

# Python
__pycache__/
*.pyc
.venv/

# OS / editor cruft
.DS_Store
.vscode/
