// COLO829 Tumour-Normal Somatic Genomics Pipeline
// nextflow.config — dev/full profiles + docker/singularity profiles.
// Phase 1 (modules/fastqc.nf, modules/alignment.nf, workflows/somatic.nf, main.nf) is wired up;
// later phases extend the same workflow rather than adding new config sections per phase.

// conf/resources.config was created back in Phase 1 (QC thresholds, later repurposed for the
// Module 3 contamination warn/fail thresholds it actually holds) but never actually wired in --
// found 2026-08-30 while wiring up Module 3's CALCULATE_CONTAMINATION, which reads
// params.qc.contamination.{warn,fail}_threshold and would otherwise hit an undefined value.
includeConfig 'conf/resources.config'

params {
    // Sample inputs — overridden per-run via -params-file or CLI
    tumour_reads_1   = null
    tumour_reads_2   = null
    normal_reads_1   = null
    normal_reads_2   = null

    // Reference resources — see docs/data_sources.md for provenance of every path below
    reference_fasta   = null   // TODO Phase 1: GRCh38 FASTA path/URL, see docs/data_sources.md §2
    panel_of_normals  = null   // gs://gatk-best-practices/somatic-hg38/1000g_pon.hg38.vcf.gz
    germline_resource = null   // gs://gatk-best-practices/somatic-hg38/af-only-gnomad.hg38.vcf.gz
    common_biallelic_sites = null // gs://gatk-best-practices/somatic-hg38/small_exac_common_3.hg38.vcf.gz

    // Truth set — TODO pending decision, see docs/PHASE0_FINDINGS.md §1
    truth_set_vcf     = null
    truth_set_bed     = null

    // Dev-profile interval restriction
    dev_interval_list = "${projectDir}/data/gene_lists/dev_intervals.bed" // TODO Phase 1: populate real GRCh38 coordinates

    outdir = "results"
}

profiles {

    // dev: chr21 + a small melanoma-driver-gene interval list, for fast end-to-end DAG testing
    // without committing to a full-WGS run. See data/gene_lists/melanoma_genes.tsv for the
    // gene list this interval set is derived from (Phase 1 task: turn genes into real BED coords).
    //
    // IMPORTANT scope note (Phase 1): params.interval_list only restricts steps that take a
    // GATK-style -L argument (Mutect2, HaplotypeCaller-equivalent -- Phase 2+). It does NOT
    // shrink the FASTQ input to BWA_MEM2_ALIGN in modules/alignment.nf -- alignment always
    // processes whatever FASTQs are pointed at by tumour_reads_1/2 and normal_reads_1/2,
    // full genome or not, since there's no genomic coordinate to restrict on before alignment
    // exists. For a genuinely fast dev-profile smoke test of Modules 1-2, point those four
    // params at a small subsampled/region-extracted FASTQ pair yourself (e.g. a few thousand
    // reads, or reads from a chr21 BAM slice) -- the dev profile doesn't do this for you at
    // the alignment stage. See docs/PHASE1_NOTES.md for detail.
    dev {
        params.interval_list = params.dev_interval_list
        params.profile_name  = 'dev'
        process {
            executor = 'local'
            cpus     = 4
            memory   = '8 GB'

            // BWA_MEM2_ALIGN needs far more than the flat 8GB default whenever reference_fasta
            // points at the full genome. CORRECTION 2026-08-30: this pipeline's docs previously
            // claimed "~19GB to use an already-built index" -- that figure was never actually
            // verified (unlike the ~28N GB indexing figure, which IS documented in bwa-mem2's own
            // README) and turned out to be too low: it still OOM-killed at both 24GB and 26GB
            // caps. Checked properly this time -- real-world reports (bwa-mem2 GitHub issues #64,
            // #115; NIH HPC docs) show the `mem` step commonly needs 30-100+GB on a full human
            // genome, scaling up with thread count (more threads = more concurrent per-thread
            // read/result buffers). Two changes here: (1) memory raised again to 26GB (this
            // machine's practical ceiling, see executor{} note below), and (2) cpus dropped to 1
            // -- our dev-profile test is only 10,000 read pairs, so thread-buffer overhead should
            // be the main lever left to pull, not read volume. If this still OOMs, the honest
            // conclusion (paralleling the index-BUILD memory problem already solved via AWS) is
            // that full-genome alignment itself doesn't fit on this 32GB machine either, and the
            // same one-off cloud-burst approach used for BWA_MEM2_INDEX should be used here too.
            withName: 'BWA_MEM2_ALIGN' {
                memory = '26 GB'
                cpus   = 1
            }
        }
    }

    // full: whole-genome, no interval restriction
    full {
        params.interval_list = null
        params.profile_name  = 'full'
        process {
            executor = 'local'
            cpus     = 4
            memory   = '8 GB'

            // See the identical note in the dev profile above -- same fix, same reason.
            withName: 'BWA_MEM2_ALIGN' {
                memory = '26 GB'
                cpus   = 1
            }
        }
    }

    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }

    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
    }
}

// This caps the LOCAL executor's total scheduling pool (separate from each process's own
// `memory` directive, which sets what a single task actually requests/gets from Docker).
// Raised 8GB -> 24GB -> 26GB across 2026-08-30, alongside the BWA_MEM2_ALIGN per-process
// override above -- a pool cap smaller than a single task's own request would mean Nextflow
// can never schedule that task at all. 26GB is close to this machine's practical ceiling: 32GB
// physical RAM, with WSL2 raised (via .wslconfig) to give its own VM 28GB, leaving a couple GB
// for Windows itself and Docker/WSL overhead. It still deliberately serialises the two samples'
// BWA_MEM2_ALIGN tasks (2x26GB > both the pool and physical RAM) rather than trying to run both
// at once. If BWA_MEM2_ALIGN still OOMs at this ceiling even with cpus=1 (see note above), that's
// good evidence this machine cannot run full-genome bwa-mem2 alignment locally at all, regardless
// of tuning -- the same conclusion already reached for index BUILDING, solved there via a one-off
// AWS instance (docs/PHASE1_NOTES.md) -- and the same approach should be used for alignment too.
executor {
    cpus   = 4
    memory = '26 GB'
}

manifest {
    name            = 'COLO829-somatic-pipeline'
    description     = 'Tumour-normal somatic genomics pipeline benchmarked against COLO829/COLO829BL'
    author          = 'Krzysztof Gizynski'
    nextflowVersion = '>=24.04.0'
}
